<!DOCTYPE html>
<html lang="en">

<head>
  <link rel="stylesheet" href="/css/main.css" />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<!-- 로그인 페이지 -->

<body>
  <div class="login-box">
    <form name="mainForm">
      <div>
        <div>아이디</div>
        <input class="emailinput" type="email" placeholder="이메일을 작성해 주세요." name="id" required />
      </div>

      <div>
        <div>비밀번호</div>
        <input class="pass" type="password" placeholder="비밀번호를 입력해 주세요." name="pass" required />
      </div>
      <div class="text info"></div>
      <input type="button" onclick="onClicks()" value="로그인" />
    </form>
  </div>
</body>

</html>

<script>

  // axios
  const onClicks = () => {
    const mainForm = document.mainForm;
    const info = document.querySelector(".info");
    const ids = mainForm.id.value;
    const pws = mainForm.pass.value;
    const data = {
      id: ids,
      pw: pws,
    };

    axios({
      method: "post",
      url: "/axiospost",
      data: data,
    }).then((res) => {
      console.log(res)
      if (res.data === 404) {
        info.innerHTML = `<div class="red">아이디 또는 비밀번호를 잘못 입력했습니다. 입력하신 내용을 다시 확인해주세요.</div>`;
      } else {
        info.innerHTML = `<div class="blue">로그인 성공!!</div>`;
      }
    }).catch((e) => {
      console.log("에러");
    })
      ;
  };
</script>